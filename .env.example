# Runtime/app connection. For Supabase transaction pooler URLs on port 6543, keep pgbouncer=true.
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/postgres?pgbouncer=true&connection_limit=1"

# Migration connection. Use the direct Supabase database URL on port 5432, not the pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"
